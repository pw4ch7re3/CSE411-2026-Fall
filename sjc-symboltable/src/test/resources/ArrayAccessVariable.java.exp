"a" in "a=new int[]{1,2,3}" ==> int[] a;
"a" in "a[a[i]]" ==> int[] a;
"a" in "a[b[a[i]]]" ==> int[] a;
"a" in "a[i]" ==> int[] a;
"b" in "b=new int[3]" ==> int[] b;
"b" in "b[a[i] * i]" ==> int[] b;
"b" in "b[a[i]]" ==> int[] b;
